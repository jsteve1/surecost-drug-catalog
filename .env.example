# Django secret key — generate a unique value for each environment
SECRET_KEY=change-me-to-a-random-secret-key

# Enable Django debug mode (set to False in production)
DEBUG=True

# Database connection string (SQLite for local dev, PostgreSQL for Docker)
DATABASE_URL=sqlite:///db.sqlite3

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins for the frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated Django ALLOWED_HOSTS
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend API base URL (used by Next.js at build/runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
