# Django secret key — generate a unique value for each environment
SECRET_KEY=change-me-to-a-random-secret-key

# Enable Django debug mode (set to False in production)
DEBUG=True

# Database connection string (SQLite for local dev, PostgreSQL for Docker)
DATABASE_URL=sqlite:///db.sqlite3

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins for the frontend
# Production: https://app.gaspartech.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Comma-separated Django ALLOWED_HOSTS
# Production: api.gaspartech.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins (Django admin; add tunnel hostname in production)
# Production: https://api.gaspartech.com,https://app.gaspartech.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Frontend API base URL (used by Next.js at build/runtime)
# Production: https://api.gaspartech.com/api (set as CI build-time var)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
